# Zero-cost Linux development defaults use local Exasol Docker Edition.
# For Exasol Personal, replace these values with the output from `exasol info`.
SSS_EXASOL_DSN=127.0.0.1:8563
SSS_EXASOL_USER=sys
SSS_EXASOL_PASSWORD=exasol
SSS_EXASOL_SCHEMA=SSS
SSS_EXASOL_REQUIRED=false

# Runtime
SSS_ENV=development
SSS_POLICY_VERSION=sss-hackathon-v3
SSS_PUBLIC_BASE_URL=http://localhost:8000
SSS_RUNTIME_ROOT=

# API foundations
SSS_API_BEARER_TOKENS=
SSS_API_TOKEN=
SSS_API_MAX_BODY_BYTES=1048576
SSS_IDEMPOTENCY_KEY_MAX_BYTES=128
SSS_SSE_HEARTBEAT_SECONDS=15
SSS_SSE_BUFFER_SIZE=512

# Browser runtime (public values only; never expose service or signing tokens)
# Leave empty for the same-origin Vite proxy; set only when serving the UI separately.
VITE_SSS_API_BASE_URL=
VITE_SSS_HTTP_TIMEOUT_MS=5000
VITE_SSS_USE_PROTOTYPE_DATA=false

# External collectors and approval signing are disabled until explicitly configured.
SSS_GITHUB_TOKEN=
SSS_MODEL_PROVIDER_API_KEY=
SSS_MODEL_PROVIDER_KEYS=
SSS_MODEL_BASE_URL=
SSS_MODEL_ID=
SSS_MODEL_TOKEN_FILE=
SSS_PROMPT_MANIFEST=
SSS_ALLOW_PRIVATE_HTTP_MODEL=false
SSS_MODEL_TIMEOUT_SECONDS=30
SSS_MODEL_MAX_RESPONSE_BYTES=1048576
SSS_MODEL_RETRY_ATTEMPTS=3
SSS_WORKER_CONCURRENCY=2
SSS_APPROVAL_SIGNING_KEY=
SSS_TELEMETRY_ENABLED=false
SSS_STRICT_MODE=true
SSS_RAW_RESPONSE_RETENTION=false

# Registry and gateway
SSS_PYPI_BASE_URL=https://pypi.org
SSS_NPM_REGISTRY_URL=https://registry.npmjs.org
SSS_GATEWAY_UPSTREAMS_JSON={"pypi":"https://pypi.org","npm":"https://registry.npmjs.org"}
# Exact metadata paths use null; artifact paths require their lowercase SHA-256.
# Generate this per protected session from the reviewed lockfile/approval set.
SSS_GATEWAY_PERMITS_JSON={"npm":{"/safe-lib":null,"/safe-lib/-/safe-lib-1.0.0.tgz":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}}
SSS_GATEWAY_MAX_ARTIFACT_BYTES=20971520
SSS_GATEWAY_MAX_EXPANDED_BYTES=104857600
SSS_GATEWAY_MAX_ARCHIVE_ENTRIES=10000
SSS_GATEWAY_MAX_FILE_BYTES=5242880
SSS_GATEWAY_MAX_COMPRESSION_RATIO=200
SSS_GATEWAY_CONNECT_TIMEOUT_SECONDS=3
SSS_GATEWAY_READ_TIMEOUT_SECONDS=15

# CLI and protected workspace
SSS_API_URL=http://localhost:8000
SSS_GATEWAY_URL=http://localhost:8080
SSS_PROTECTED_API_URL=http://api:8000
SSS_PROTECTED_GATEWAY_URL=http://gateway:8080
SSS_REAL_EXECUTABLES_JSON={}
SSS_DOCKER_EXECUTABLE=docker
SSS_PROTECTED_COMPOSE_FILE=infra/docker/compose.protected.yaml
SSS_PROTECTED_SERVICE=protected-agent
SSS_ALLOWED_ENV_KEYS=PATH,LANG,LC_ALL,TERM,CI,SYSTEMROOT,WINDIR,COMSPEC,PATHEXT,TEMP,TMP
SSS_AGENT_IMAGE=
SSS_PROTECTED_NETWORK=sss-protected
SSS_GUARD_SESSION_TOKEN=
SSS_ARTIFACT_SHA256=
SSS_PROJECT_ID=project-demo
SSS_AGENT_FAMILY=codex
SSS_DEMO_ARTIFACT_SHA256=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

# Demo-only local services
SSS_CANARY_DATABASE_PATH=.runtime/canary/events.db
SSS_CANARY_TOKEN=
SSS_CANARY_MARKER=DEMO_ONLY_NOT_A_SECRET
SSS_PROJECT_PATH=
SSS_PYTHON_BASE_IMAGE=
SSS_UV_VERSION=0.12.13
SSS_NODE_BASE_IMAGE=
SSS_API_HOST_PORT=8000
SSS_GATEWAY_HOST_PORT=8080
