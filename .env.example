# Exasol Personal connection supplied by `exasol info` after AWS/Azure provisioning.
# Local database deployment currently requires macOS 15+ on Apple silicon.
SSS_EXASOL_DSN=exasol-personal-host:8563
SSS_EXASOL_USER=sss_app
SSS_EXASOL_PASSWORD=change-me
SSS_EXASOL_SCHEMA=SSS

# External collectors are disabled unless explicitly configured.
SSS_GITHUB_TOKEN=
SSS_MODEL_PROVIDER_API_KEY=
