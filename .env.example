# Zero-cost Linux development defaults for the local Exasol Docker Edition profile.
# For Exasol Personal, replace these values with the output from `exasol info`.
SSS_EXASOL_DSN=127.0.0.1:8563
SSS_EXASOL_USER=sys
SSS_EXASOL_PASSWORD=exasol
SSS_EXASOL_SCHEMA=SSS

# External collectors are disabled unless explicitly configured.
SSS_GITHUB_TOKEN=
SSS_MODEL_PROVIDER_API_KEY=
