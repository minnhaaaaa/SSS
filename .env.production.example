# Immutable application base images used in the validated local qualification.
SSS_PYTHON_BASE_IMAGE=python:3.12.14-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
SSS_NODE_BASE_IMAGE=node:22.23.2-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5
SSS_GO_BASE_IMAGE=golang:1.26.6-alpine@sha256:3889b425f035be855a72fb4755265311293b6d414521f0a519d819df32222d83
SSS_ALPINE_BASE_IMAGE=alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
SSS_UV_VERSION=0.12.13
SSS_NPM_VERSION=12.0.2
SSS_PNPM_VERSION=10.31.0
SSS_POETRY_VERSION=2.4.3

# External Exasol Personal connection. No Exasol container is in production Compose.
SSS_EXASOL_DSN=exasol.internal.example:8563
SSS_EXASOL_USER=sss_service
SSS_EXASOL_SCHEMA=SSS
SSS_EXASOL_PASSWORD_FILE=./secrets/exasol_password

# Scoped service credentials and signing material.
SSS_APPROVAL_SIGNING_KEY_FILE=./secrets/approval_signing_key
SSS_API_CREDENTIALS_FILE=./secrets/api_credentials.json
SSS_BROWSER_API_TOKEN_FILE=./secrets/browser_api_token
SSS_AGENT_API_TOKEN_FILE=./secrets/agent_api_token
SSS_MODEL_PROVIDER_TOKEN_FILE=./secrets/model_provider_token

# TLS and one-organization operator authentication.
SSS_TLS_HOST=sss.example.com
SSS_TLS_PORT=8443
SSS_TLS_CERTIFICATE_FILE=./secrets/tls_certificate.pem
SSS_TLS_PRIVATE_KEY_FILE=./secrets/tls_private_key.pem
SSS_OPERATOR_USERNAME=operator
SSS_OPERATOR_PASSWORD_HASH_FILE=./secrets/operator_password_hash

# Approved model collector and reviewed prompts.
SSS_MODEL_BASE_URL=https://model-provider.example/v1
SSS_MODEL_ID=approved-model-id
SSS_PROMPT_MANIFEST_FILE=./config/prompts.jsonl
SSS_MODEL_TIMEOUT_SECONDS=30
SSS_MODEL_MAX_RESPONSE_BYTES=1048576
SSS_MODEL_RETRY_ATTEMPTS=3
SSS_WORKER_CONCURRENCY=2

# Registry allowlists. Metadata uses null; every artifact requires its SHA-256.
SSS_GATEWAY_UPSTREAMS_JSON={"pypi":"https://pypi.org","npm":"https://registry.npmjs.org"}
SSS_GATEWAY_PERMITS_JSON={"npm":{"/safe-lib":null,"/safe-lib/-/safe-lib-1.0.0.tgz":"REPLACE_WITH_64_LOWERCASE_HEX"}}
SSS_GATEWAY_MAX_ARTIFACT_BYTES=20971520

# Optional protected-agent profile.
SSS_PROJECT_PATH=.
SSS_PROJECT_ID=replace-with-project-pseudonym
SSS_AGENT_FAMILY=local-agent
SSS_ARTIFACT_SHA256=REPLACE_WITH_64_LOWERCASE_HEX
